VITE_API_URL=/api

# Acceso con Google para jugadores. Client ID de OAuth (Google Cloud Console →
# Credenciales → ID de cliente de OAuth, tipo Aplicación web), con esta URL en
# "Orígenes autorizados de JavaScript".
#
# Tiene que ser el MISMO valor que GOOGLE_CLIENT_ID del backend. Vacío = el
# botón de Google no aparece y el login sigue funcionando con email y contraseña.
VITE_GOOGLE_CLIENT_ID=

# Opcional. Sin key, el mapa del complejo usa el embed clásico de Google Maps,
# que no la necesita. Setearla activa la Embed API (mejor render y más opciones)
# y requiere una cuenta de Google Cloud con facturación habilitada.
VITE_GOOGLE_MAPS_API_KEY=

# DSN del proyecto de Sentry del FRONTEND (en sentry.io, plataforma Vue). Es
# distinto del SENTRY_DSN del backend: son dos proyectos, para que los errores
# del navegador no se mezclen con los del servidor.
#
# Vacío = no se reporta nada, que es lo que se quiere en local. Acordate de que
# Vite hornea esto en el build: cambiarlo en Vercel pide un Redeploy manual.
VITE_SENTRY_DSN=
