# ==========================================================================
# CourtIn · Backend — variables de entorno
# --------------------------------------------------------------------------
# Copiá este archivo como `.env` y completá los valores para tu entorno.
# dotenv solo carga `.env` (ver index.js), así que el archivo activo siempre
# es `.env`. Los `.env.*` (ej. `.env.production`) quedan como respaldo/referencia
# y NO se cargan automáticamente. Todos los `.env*` están gitignoreados excepto
# este `.env.example`.
#
# Estrategia de entornos (ver README.md → "Entornos y base de datos"):
#   • LOCAL     → MongoDB local (esta máquina). Se usa para desarrollar/probar.
#   • DEVELOP   → base de staging (Atlas: otro cluster o db aparte). La setea el deploy.
#   • PRODUCTION→ base real (Atlas). La setea el deploy. Nunca desarrollar contra ella.
# ==========================================================================

# Puerto del servidor HTTP.
PORT=3000

# --- Base de datos (MongoDB) -----------------------------------------------
# Elegí UNA según el entorno:
#
# LOCAL (recomendado para desarrollar; requiere mongod corriendo en la máquina):
MONGODB_URI=mongodb://127.0.0.1:27017/courtin_dev
#
# DEVELOP / STAGING (ejemplo Atlas, db separada de prod):
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/courtin_staging
#
# PRODUCTION (ejemplo Atlas; en el deploy real se inyecta como env var de la
# plataforma —Render/Railway/etc.—, NO se commitea):
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/courtin

# --- Auth ------------------------------------------------------------------
# Secreto para firmar los JWT. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=genera_uno_con_crypto_randomBytes

# --- Acceso con Google (jugadores) ------------------------------------------
# Client ID de OAuth de Google Cloud Console → APIs y servicios → Credenciales →
# "ID de cliente de OAuth" tipo Aplicación web. En "Orígenes autorizados de
# JavaScript" van las URLs del FRONTEND (http://localhost:5173 y el dominio de
# producción); no hace falta URI de redirección, el botón no la usa.
#
# Tiene que ser EL MISMO valor que VITE_GOOGLE_CLIENT_ID del frontend: acá se
# usa para verificar que el token que llega fue emitido para nuestra aplicación.
# Vacío = el botón de Google no se muestra y el endpoint responde 503.
GOOGLE_CLIENT_ID=

# --- CORS ------------------------------------------------------------------
# Orígenes permitidos separados por coma. Vacío = permite cualquier origen (dev).
# Producción, ej: CORS_ORIGIN=https://tu-frontend.vercel.app
CORS_ORIGIN=

# --- Proxy --------------------------------------------------------------------
# Cantidad de proxies delante de la app. Define de dónde se lee la IP real del
# cliente, que es la clave del rate limiting.
#   0 → local, sin proxy
#   1 → Render, Railway, Fly y similares (un balanceador adelante)
# No pongas un número mayor al real: cada salto de más es un tramo de
# X-Forwarded-For que el cliente puede falsificar para esquivar los límites.
TRUST_PROXY=0

# --- Almacenamiento de imágenes (Cloudinary) -------------------------------
# Para que los complejos suban logo/fotos reales. Creá una cuenta gratis en
# cloudinary.com → Dashboard → copiá el "API Environment variable".
# Formato: cloudinary://<api_key>:<api_secret>@<cloud_name>
# En Render, cargalo como env var del servicio backend.
CLOUDINARY_URL=

# --- Emails transaccionales (Resend) ---------------------------------------
# API key de resend.com → API Keys. Se usa la API HTTPS y no SMTP porque Render
# bloquea los puertos de SMTP saliente.
RESEND_API_KEY=

# Remitente. Requiere el dominio verificado en Resend (SPF + DKIM). Sin eso, el
# único remitente posible es el sandbox `onboarding@resend.dev`, que además solo
# puede escribirle a la casilla dueña de la cuenta.
MAIL_FROM="CourtIn <hola@courtinapp.com>"

# Respuesta por defecto. En los emails de una reserva se pisa con el email del
# club, así el jugador le contesta al complejo y no a nosotros.
MAIL_REPLY_TO=

# Interruptor general. En false no se envía nada: solo se loguea en consola.
MAIL_ENABLED=true

# Red de seguridad para dev/staging: manda TODOS los emails a esta casilla y
# deja el destinatario real en el asunto. Dejalo VACÍO en producción.
MAIL_DEV_REDIRECT=

# Base pública del frontend, para armar los links de los emails (confirmar
# cuenta, gestionar reserva, invitaciones). Sin barra final.
APP_PUBLIC_URL=http://localhost:5173

# --- Tareas programadas (node-cron, dentro del proceso web) ----------------
# Recordatorio de turno 24 h antes. Poné `false` en local si no querés que corra
# cada 30 minutos mientras desarrollás; en producción tiene que quedar en true.
# Para dispararlo a mano: npm run jobs:reminders
JOBS_ENABLED=true

# --- Contacto ---------------------------------------------------------------
# Casilla a la que llega todo lo que nos escriben desde la web: pedidos de demo
# de la landing y cualquier formulario de contacto. Si queda vacía se usa
# courtinapp@gmail.com, que es el default del código.
CONTACT_EMAIL=courtinapp@gmail.com

# --- Facturación / soporte --------------------------------------------------
# El abono de la suscripción se cobra por fuera de la plataforma: los emails de
# factura y de deuda mandan al complejo a contactar a soporte. Estos son los
# datos que se muestran ahí. Si SOPORTE_EMAIL queda vacío se usa MAIL_REPLY_TO.
SOPORTE_EMAIL=hola@courtinapp.com
SOPORTE_WHATSAPP=

# --- Altas de complejos -----------------------------------------------------
# Cuando alguien registra un complejo desde la web, el alta queda PENDIENTE y se
# avisa por email a los usuarios con `globalRole: superadmin` de la base. Esta
# variable es sólo el respaldo para cuando todavía no hay ninguno cargado
# (instalación nueva): si queda vacía y no hay superadmins, la solicitud se
# guarda igual pero nadie se entera.
SUPERADMIN_EMAIL=
